# Copy to .env and fill in. The app boots without a key (it falls back to a
# deterministic offline FakeLLM) so you can develop and run tests without
# spending tokens.

# Anthropic API key. Leave blank to force the offline FakeLLM.
CHATOY_ANTHROPIC_API_KEY=

# Models per agent role. Defaults target the latest Claude family.
CHATOY_CRO_MODEL=claude-sonnet-4-6
CHATOY_SHEPHERD_MODEL=claude-sonnet-4-6
CHATOY_VOICE_MODEL=claude-haiku-4-5-20251001

# Generation params
CHATOY_TEMPERATURE=0.7
CHATOY_MAX_TOKENS=2048

# Force the offline FakeLLM even when a key is present (handy for demos/CI).
CHATOY_USE_FAKE_LLM=false

# SQLAlchemy URL. Leave blank to use in-memory stores (tests / offline dev).
# Postgres example: postgresql+psycopg://chatoy:chatoy@localhost:5432/chatoy
CHATOY_DATABASE_URL=

# Auth. Bearer JWTs are verified with this secret (the Supabase project "JWT
# secret" for HS256). Endpoints fail closed (503) if it is unset.
CHATOY_JWT_SECRET=
CHATOY_JWT_AUDIENCE=authenticated
CHATOY_JWT_ALGORITHMS=HS256
# Local dev only: skip token checks and treat every request as CHATOY_DEV_USER_ID.
CHATOY_AUTH_DISABLED=false
CHATOY_DEV_USER_ID=dev-user

# Comma-separated CORS origins for the frontend.
CHATOY_CORS_ORIGINS=http://localhost:3000
