# Base URL of the MythoStack FastAPI backend.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase (public, browser-safe). When set, the app shows real login and sends
# the Supabase session token to the backend. When unset, the app runs in
# "dev token" mode (paste a bearer token in the chat Settings).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
