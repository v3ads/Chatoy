# Copy to .env and fill in. The app boots without a key (it falls back to a
# deterministic offline FakeLLM) so you can develop and run tests without
# spending tokens.

# Anthropic API key. Leave blank to force the offline FakeLLM.
MYTHOSTACK_ANTHROPIC_API_KEY=

# Models per agent role. Defaults target the latest Claude family.
MYTHOSTACK_ARCHITECT_MODEL=claude-sonnet-4-6
MYTHOSTACK_WRITER_MODEL=claude-sonnet-4-6
MYTHOSTACK_VOICE_MODEL=claude-haiku-4-5-20251001

# Generation params
MYTHOSTACK_TEMPERATURE=0.7
MYTHOSTACK_MAX_TOKENS=2048

# Force the offline FakeLLM even when a key is present (handy for demos/CI).
MYTHOSTACK_USE_FAKE_LLM=false

# SQLAlchemy URL. Leave blank to use in-memory stores (tests / offline dev).
# Postgres example: postgresql+psycopg://chatoy:chatoy@localhost:5432/chatoy
MYTHOSTACK_DATABASE_URL=

# Auth. Two ways to verify Supabase bearer JWTs (pick one):
#
#   A) Asymmetric signing keys (current Supabase default) -- RECOMMENDED.
#      Set your project URL; the backend fetches public keys from its JWKS
#      endpoint and verifies ES256/RS256. No secret to manage.
MYTHOSTACK_SUPABASE_URL=
#      (Optional explicit override of the JWKS endpoint.)
MYTHOSTACK_JWKS_URL=
#
#   B) Legacy HS256 shared secret (older projects).
MYTHOSTACK_JWT_SECRET=
#
MYTHOSTACK_JWT_AUDIENCE=authenticated
MYTHOSTACK_JWT_ALGORITHMS=HS256
# Endpoints fail closed (503) if none of the above is set.
# Local dev only: skip token checks and treat every request as CHATOY_DEV_USER_ID.
MYTHOSTACK_AUTH_DISABLED=false
MYTHOSTACK_DEV_USER_ID=dev-user

# Comma-separated CORS origins for the frontend.
MYTHOSTACK_CORS_ORIGINS=http://localhost:3000
